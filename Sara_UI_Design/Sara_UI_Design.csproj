<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
		<LangVersion Condition="'$(TargetFramework)' == 'net48'">10.0</LangVersion>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<PackageId>Sara_UI_Design</PackageId>
		<Version>2.0.0</Version>
		<Authors>CristobalRodas</Authors>
		<Description>Biblioteca de controles personalizables para Windows Forms compatible con .NET 8 y .NET Framework 4.8. Incluye animaciones, paneles de diseño, menús e iconos vectoriales.</Description>
		<PackageProjectUrl>https://github.com/0r3k1/Sara_UI_Design</PackageProjectUrl>
		<RepositoryUrl>https://github.com/0r3k1/Sara_UI_Design.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>winforms;controles;interfaz;ui;net8;net48;animaciones;iconos</PackageTags>
		<PackageIcon>logo.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>2.0.0: motor de animaciones propio, controles modernizados, compatibilidad con .NET 8 y .NET Framework 4.8, biblioteca de iconos ampliada y manual oficial.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="logo.png" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

</Project>
